DJANGO_DEBUG=0
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_ALLOWED_HOSTS=botakanym.edu.kz,www.botakanym.edu.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://botakanym.edu.kz,https://www.botakanym.edu.kz
# Путь к админке. Не оставляйте "admin/" — меньше автоматических атак.
DJANGO_ADMIN_URL=manage/
# HSTS: начните с 3600, после проверки HTTPS поставьте 31536000
DJANGO_HSTS_SECONDS=3600
MEDIA_ROOT=/var/www/kindergarten-site/media
# Адрес e-orda, с которого закладки передают табель и контакты (через запятую, если несколько)
# PAYMENTS_EORDA_ORIGINS=https://int.indigo.nursultan.e-orda.kz
# Медицинская документация: шапка и подпись руководителя в печатных формах
# MEDJOURNAL_ORG_NAME=Детский сад «Ботаканым»
# MEDJOURNAL_ORG_HEAD=Фамилия И.О.
# PostgreSQL (если не заданы — используется SQLite)
# POSTGRES_DB=kgsite
# POSTGRES_USER=kgsite
# POSTGRES_PASSWORD=...
# POSTGRES_HOST=127.0.0.1
